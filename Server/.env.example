MONGODB_URI=mongodb+srv://<user>:<password>@<cluster>/<database>
MONGODB_DB_NAME=studytwin
# Set a strong secret to enable the protected attempt-export API:
# ATTEMPT_EXPORT_TOKEN=
# Local demo without MongoDB (in-memory progress + attempt logs):
# MEMORY_STORE=1

# Local-only default. For hosted Node, set the public FastAPI URL, not loopback.
ML_API_URL=http://127.0.0.1:8000
# Comma-separated exact origins only when frontend and API use different hosts.
CORS_ORIGINS=
# Trusted reverse-proxy hop count; leave 0 for direct/local hosting.
TRUST_PROXY_HOPS=0
# Gemini step review (recommended): obtain a key in Google AI Studio.
GEMINI_API_KEY=
GEMINI_MODEL=gemini-2.5-flash

# Optional OpenAI-compatible provider fallback if Gemini is not configured.
LLM_API_URL=
LLM_API_KEY=
LLM_MODEL=

# Answer submission rate limits (per client IP)
RATE_LIMIT_ANSWER_PER_MIN=30
RATE_LIMIT_ANSWER_DAILY=200
