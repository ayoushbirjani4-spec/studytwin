{
  "version": "0.0.1",
  "configurations": [
    {
      "name": "ml",
      "runtimeExecutable": "python",
      "runtimeArgs": ["-m", "uvicorn", "api:app", "--app-dir", "ML", "--host", "127.0.0.1", "--port", "8000"],
      "port": 8000
    },
    {
      "name": "server",
      "runtimeExecutable": "node",
      "runtimeArgs": ["Server/index.js"],
      "port": 3000
    },
    {
      "name": "server-memory",
      "runtimeExecutable": "cmd",
      "runtimeArgs": ["/c", "set MEMORY_STORE=1&& node Server/index.js"],
      "port": 3000
    },
    {
      "name": "server-mongo",
      "runtimeExecutable": "cmd",
      "runtimeArgs": ["/c", "set MEMORY_STORE=0&& node Server/index.js"],
      "port": 3000
    }
  ]
}
